+/// Real TPC-DS q67 rollup benchmark.
+///
+/// Reads the ACTUAL rollup input of q67 -- the joined and filtered rows that
+/// reach the ROLLUP, exported from SF10 dsdgen data:
+///
+///     5,342,291 rows / 4,804,937 distinct 8-key groups = 1.11 rows per group
+///
+/// Two plans, same input, both ending at pre-shuffle partial state:
+///
+///   (a) VANILLA, what Gluten produces today:
+///         Values -> Expand(9 sets) -> partial HashAggregation(k1..k8, gid)
+///       Expand materialises 9x the rows and every one is hash-probed.
+///
+///   (b) FUSED, the merged grouping-set operator:
+///         Values -> partial HashAggregation(k1..k8) -> MultiGroupingSetAggregation
+///       The finest grain is computed once, then the lattice derives the eight
+///       coarser sets from already-collapsed state, with the finest set bypassed.
+///
+/// Both get a large partial-aggregation budget so neither flushes; flushing is
+/// a separate axis with a known Expand+aggregation crash.
+///
+/// Run with Q67_INPUT=<dir of exported parquet>.
+///
+/// OPEN -- THIS FILE IS IN NO CMakeLists.txt. It has only ever been compiled by
+/// hand, so nothing catches it when an upstream API changes, and a reviewer who
+/// tries to reproduce the numbers it produces finds an artifact that does not
+/// build. Before this goes into a PR it must either be deleted or moved to
+/// velox/benchmarks/ and registered with velox_add_benchmark, so CI COMPILES it
+/// (compilation is what prevents rot; running it in CI is neither needed nor
+/// wanted, given the external dataset). Q67_INPUT must then skip cleanly when
+/// unset, and a small synthetic in-tree variant reproducing q67's cardinality
+/// profile (1.11 rows/group) should carry the reproducible number, with the
+/// real-data run as corroboration.
+
+#include <folly/init/Init.h>
+
+#include <chrono>
+#include <filesystem>
+#include <numeric>
+#include <random>
+
+#include "velox/dwio/parquet/RegisterParquetReader.h"
+#include "velox/exec/GroupingSetAggregationNode.h"
+#include "velox/exec/MultiGroupingSetAggregation.h"
+#include "velox/exec/tests/utils/AssertQueryBuilder.h"
+#include "velox/exec/tests/utils/HiveConnectorTestBase.h"
+#include "velox/exec/tests/utils/PlanBuilder.h"
+
+using namespace facebook::velox;
+using namespace facebook::velox::exec::test;
+
+namespace facebook::velox::exec {
+
+namespace {
+constexpr int32_t kNumKeys = 8;
+
+RowTypePtr q67InputType() {
+  return ROW(
+      {"k1", "k2", "k3", "k4", "k5", "k6", "k7", "k8", "v"},
+      {VARCHAR(),
+       VARCHAR(),
+       VARCHAR(),
+       VARCHAR(),
+       BIGINT(),
+       BIGINT(),
+       BIGINT(),
+       VARCHAR(),
+       DOUBLE()});
+}
+
+std::vector<std::string> keyNames() {
+  std::vector<std::string> names;
+  for (auto i = 1; i <= kNumKeys; ++i) {
+    names.push_back(fmt::format("k{}", i));
+  }
+  return names;
+}
+
+/// ROLLUP(k1..k8): 9 sets, dropping one trailing key at a time. gid follows
+/// Spark's convention (bit set == key excluded): 0,1,3,7,15,31,63,127,255.
+std::vector<GroupingSetAggregationNode::Set> rollupSets() {
+  std::vector<GroupingSetAggregationNode::Set> sets;
+  for (auto dropped = 0; dropped <= kNumKeys; ++dropped) {
+    GroupingSetAggregationNode::Set set;
+    set.keyIsActive.assign(kNumKeys, false);
+    for (auto j = 0; j < kNumKeys - dropped; ++j) {
+      set.keyIsActive[j] = true;
+    }
+    set.gid = (int64_t{1} << dropped) - 1;
+    sets.push_back(std::move(set));
+  }
+  return sets;
+}
+} // namespace
+
+class Q67RollupBenchmarkTest : public HiveConnectorTestBase {
+ protected:
+  void SetUp() override {
+    HiveConnectorTestBase::SetUp();
+    parquet::registerParquetReaderFactory();
+    registerMultiGroupingSetAggregation();
+  }
+
+  std::vector<RowVectorPtr> loadInput(const std::string& dir) {
+    std::vector<std::shared_ptr<connector::ConnectorSplit>> splits;
+    for (const auto& entry : std::filesystem::directory_iterator(dir)) {
+      const auto path = entry.path().string();
+      if (path.size() > 8 && path.substr(path.size() - 8) == ".parquet") {
+        for (auto& hs : HiveConnectorTestBase::makeHiveConnectorSplits(
+                 path, 1, dwio::common::FileFormat::PARQUET)) {
+          splits.push_back(std::move(hs));
+        }
+      }
+    }
+    VELOX_CHECK(!splits.empty(), "no .parquet files under {}", dir);
+    auto plan = PlanBuilder(pool())
+                    .tableScan(q67InputType())
+                    .planNode();
+    auto all = AssertQueryBuilder(plan).splits(splits).copyResults(pool());
+    std::vector<RowVectorPtr> batches;
+    constexpr vector_size_t kBatch = 20'000;
+    for (vector_size_t off = 0; off < all->size(); off += kBatch) {
+      const auto n = std::min<vector_size_t>(kBatch, all->size() - off);
+      batches.push_back(
+          std::dynamic_pointer_cast<RowVector>(all->slice(off, n)));
+    }
+    return batches;
+  }
+
+  core::PlanNodePtr vanillaPlan(
+      const std::vector<RowVectorPtr>& input,
+      bool withFinal = true) {
+    const auto keys = keyNames();
+    std::vector<std::vector<std::string>> projections;
+    for (auto dropped = 0; dropped <= kNumKeys; ++dropped) {
+      std::vector<std::string> proj;
+      for (auto j = 0; j < kNumKeys; ++j) {
+        proj.push_back(
+            j < kNumKeys - dropped ? keys[j]
+                                   : fmt::format("null as {}", keys[j]));
+      }
+      proj.push_back("v");
+      proj.push_back(
+          fmt::format("{} as gid", (int64_t{1} << dropped) - 1));
+      projections.push_back(std::move(proj));
+    }
+    auto grouping = keys;
+    grouping.push_back("gid");
+    PlanBuilder b(pool());
+    b.values(input).expand(projections).partialAggregation(
+        grouping, {"sum(v) as s"});
+    if (withFinal) {
+      b.finalAggregation(grouping, {"sum(s) as s"}, {{DOUBLE()}});
+    }
+    return b.planNode();
+  }
+
+  core::PlanNodePtr fusedPlan(
+      const std::vector<RowVectorPtr>& input,
+      bool withFinal = true) {
+    PlanBuilder builder(pool());
+    auto child = builder.values(input)
+                     .partialAggregation(keyNames(), {"sum(v) as s"})
+                     .planNode();
+    const auto* childAgg =
+        dynamic_cast<const core::AggregationNode*>(child.get());
+    VELOX_CHECK_NOT_NULL(childAgg);
+
+    // Aggregates re-expressed over the child's intermediate column.
+    std::vector<core::AggregationNode::Aggregate> aggregates;
+    for (size_t i = 0; i < childAgg->aggregates().size(); ++i) {
+      const auto& partial = childAgg->aggregates()[i];
+      core::AggregationNode::Aggregate agg;
+      for (const auto& rawInput : partial.call->inputs()) {
+        agg.rawInputTypes.push_back(rawInput->type());
+      }
+      const auto intermediateType =
+          resolveIntermediateType(partial.call->name(), agg.rawInputTypes);
+      const auto& childOutput = childAgg->outputType();
+      const auto channel = childAgg->groupingKeys().size() + i;
+      std::vector<core::TypedExprPtr> inputs = {
+          std::make_shared<core::FieldAccessTypedExpr>(
+              childOutput->childAt(channel), childOutput->nameOf(channel))};
+      agg.call = std::make_shared<core::CallTypedExpr>(
+          intermediateType, std::move(inputs), partial.call->name());
+      aggregates.push_back(std::move(agg));
+    }
+
+    std::vector<core::FieldAccessTypedExprPtr> groupingKeys;
+    for (const auto& name : keyNames()) {
+      groupingKeys.push_back(std::make_shared<core::FieldAccessTypedExpr>(
+          child->outputType()->findChild(name), name));
+    }
+
+    builder.addNode([&](std::string id, core::PlanNodePtr source) {
+      return std::make_shared<GroupingSetAggregationNode>(
+          std::move(id),
+          groupingKeys,
+          rollupSets(),
+          childAgg->aggregateNames(),
+          aggregates,
+          // NO_BYPASS gives the finest set its own hash table. Costs 5.34M
+          // extra local probes, but makes set0's 4.8M output rows come out of
+          // a hash table (in hash-bucket order) instead of being forwarded in
+          // the child's arrival order. Isolates ROW ORDER as a cost to the
+          // downstream final aggregation.
+          /*childGroupedSet=*/
+          getenv("NO_BYPASS") ? std::optional<int32_t>()
+                              : std::optional<int32_t>(0),
+          std::move(source));
+    });
+    if (withFinal) {
+      auto g = keyNames();
+      g.push_back("gid");
+      builder.finalAggregation(g, {"sum(s) as s"}, {{DOUBLE()}});
+    }
+    return builder.planNode();
+  }
+
+  std::pair<int64_t, int64_t> timeIt(const core::PlanNodePtr& plan) {
+    std::unordered_map<std::string, std::string> cfg{
+        {core::QueryConfig::kMaxPartialAggregationMemory, "2147483648"},
+        {core::QueryConfig::kMaxExtendedPartialAggregationMemory,
+         "2147483648"}};
+    // TEMPORARY diagnostic knobs.
+    if (const char* p = getenv("ABANDON_PCT")) {
+      cfg[core::QueryConfig::kAbandonPartialAggregationMinPct] = p;
+    }
+    if (const char* r = getenv("ABANDON_ROWS")) {
+      cfg[core::QueryConfig::kAbandonPartialAggregationMinRows] = r;
+    }
+    // Shrinks the partial-aggregation budget so the flush path -- and with it
+    // the post-drain abandon valve -- is actually reachable on this input.
+    if (const char* m = getenv("PARTIAL_MEM")) {
+      cfg[core::QueryConfig::kMaxPartialAggregationMemory] = m;
+      cfg[core::QueryConfig::kMaxExtendedPartialAggregationMemory] = m;
+    }
+    // OUTPUT-PATH probe. MGSA calls Operator::outputBatchRows() with no row-size
+    // estimate, so it always gets preferred_output_batch_rows (1024), while
+    // HashAggregation passes an estimate and lands on max_output_batch_rows
+    // (10000). Raising this knob equalises the two.
+    if (const char* b = getenv("OUT_BATCH_ROWS")) {
+      cfg[core::QueryConfig::kPreferredOutputBatchRows] = b;
+    }
+    auto t0 = std::chrono::steady_clock::now();
+    auto r = AssertQueryBuilder(plan).configs(cfg).copyResults(pool());
+    auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                  std::chrono::steady_clock::now() - t0)
+                  .count();
+    return {ms, r->size()};
+  }
+
+  /// Runs `plan` once and prints every operator's stats.
+  void statsFor(const std::string& label, const core::PlanNodePtr& plan) {
+    std::unordered_map<std::string, std::string> cfg{
+        {core::QueryConfig::kMaxPartialAggregationMemory, "2147483648"},
+        {core::QueryConfig::kMaxExtendedPartialAggregationMemory,
+         "2147483648"}};
+    if (const char* m = getenv("PARTIAL_MEM")) {
+      cfg[core::QueryConfig::kMaxPartialAggregationMemory] = m;
+      cfg[core::QueryConfig::kMaxExtendedPartialAggregationMemory] = m;
+    }
+    if (const char* b = getenv("OUT_BATCH_ROWS")) {
+      cfg[core::QueryConfig::kPreferredOutputBatchRows] = b;
+    }
+    std::shared_ptr<Task> task;
+    auto t0 = std::chrono::steady_clock::now();
+    const auto numRows =
+        AssertQueryBuilder(plan).configs(cfg).countResults(task);
+    const auto wallMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+                            std::chrono::steady_clock::now() - t0)
+                            .count();
+    const auto stats = task->taskStats();
+    fprintf(
+        stderr,
+        "\n================ %s  total=%lldms finalRows=%lld ================\n",
+        label.c_str(),
+        (long long)wallMs,
+        (long long)numRows);
+    for (const auto& pipeline : stats.pipelineStats) {
+      for (const auto& op : pipeline.operatorStats) {
+        fprintf(
+            stderr,
+            "  op=%-28s node=%-4s\n"
+            "      addInput   wall=%8.1fms cpu=%8.1fms\n"
+            "      getOutput  wall=%8.1fms cpu=%8.1fms\n"
+            "      finish     wall=%8.1fms cpu=%8.1fms\n"
+            "      input  rows=%12lld bytes=%13lld vectors=%lld\n"
+            "      output rows=%12lld bytes=%13lld vectors=%lld\n",
+            op.operatorType.c_str(),
+            op.planNodeId.c_str(),
+            op.addInputTiming.wallNanos / 1e6,
+            op.addInputTiming.cpuNanos / 1e6,
+            op.getOutputTiming.wallNanos / 1e6,
+            op.getOutputTiming.cpuNanos / 1e6,
+            op.finishTiming.wallNanos / 1e6,
+            op.finishTiming.cpuNanos / 1e6,
+            (long long)op.inputPositions,
+            (long long)op.inputBytes,
+            (long long)op.inputVectors,
+            (long long)op.outputPositions,
+            (long long)op.outputBytes,
+            (long long)op.outputVectors);
+        std::vector<std::string> names;
+        for (const auto& kv : op.runtimeStats) {
+          names.push_back(kv.first);
+        }
+        std::sort(names.begin(), names.end());
+        for (const auto& name : names) {
+          const auto& m = op.runtimeStats.at(name);
+          fprintf(
+              stderr,
+              "        %-38s count=%lld sum=%lld max=%lld\n",
+              name.c_str(),
+              (long long)m.count,
+              (long long)m.sum,
+              (long long)m.max);
+        }
+      }
+    }
+    fflush(stderr);
+  }
+};
+
+TEST_F(Q67RollupBenchmarkTest, q67Stats) {
+  const char* dir = getenv("Q67_INPUT");
+  if (dir == nullptr) {
+    GTEST_SKIP() << "set Q67_INPUT to the exported q67 parquet directory";
+  }
+  auto input = loadInput(dir);
+  int64_t rows = 0;
+  for (const auto& b : input) {
+    rows += b->size();
+  }
+  fprintf(stderr, "\n[q67] loaded %lld rows\n", (long long)rows);
+
+  const char* only = getenv("ONLY");
+  const std::string sel = only == nullptr ? "" : only;
+  auto want = [&](const std::string& tag) {
+    return sel.empty() || sel == tag;
+  };
+
+  if (want("vanilla")) {
+    statsFor("WARMUP", vanillaPlan(input, false));
+    statsFor(
+        "VANILLA pre-shuffle (Expand -> partial agg)",
+        vanillaPlan(input, false));
+    statsFor("VANILLA full (with final agg)", vanillaPlan(input, true));
+  }
+  if (want("fused")) {
+    statsFor("WARMUP", fusedPlan(input, false));
+    statsFor(
+        "FUSED pre-shuffle (partial agg -> MGSA)", fusedPlan(input, false));
+    statsFor("FUSED full (with final agg)", fusedPlan(input, true));
+  }
+}
