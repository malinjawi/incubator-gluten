+TEST_F(Q67RollupBenchmarkTest, realQ67Rollup) {
+  const char* dir = getenv("Q67_INPUT");
+  if (dir == nullptr) {
+    GTEST_SKIP() << "set Q67_INPUT to the exported q67 parquet directory";
+  }
+  auto input = loadInput(dir);
+  int64_t rows = 0;
+  for (const auto& b : input) {
+    rows += b->size();
+  }
+  fprintf(
+      stderr,
+      "\n[q67] loaded %lld rows in %zu batches\n",
+      (long long)rows,
+      input.size());
+  fflush(stderr);
+
+  const char* only = getenv("ONLY");
+  const bool doVanilla = (only == nullptr || std::string(only) == "vanilla");
+  const bool doFused = (only == nullptr || std::string(only) == "fused");
+
+  std::vector<int64_t> vanillaMs, fusedMs;
+  int64_t vanillaRows = 0, fusedRows = 0;
+
+  // Q67_RUNS raises the sample count. Three runs does not separate a real
+  // change from machine drift here: observed run-to-run spread is ~20% of the
+  // mean even on an otherwise idle machine.
+  int numRuns = 3;
+  if (const char* n = getenv("Q67_RUNS")) {
+    numRuns = std::max(3, atoi(n));
+  }
+
+  // INTERLEAVED, not blocked. Timing all vanilla runs and then all fused runs
+  // makes the comparison hostage to any drift between the two blocks (thermal
+  // state, another process starting). Alternating puts both arms under the same
+  // conditions in every round, so drift inflates both sides together and
+  // largely cancels out of the ratio.
+  if (doVanilla) {
+    timeIt(vanillaPlan(input));
+  }
+  if (doFused) {
+    timeIt(fusedPlan(input));
+  }
+  for (int i = 0; i < numRuns; ++i) {
+    if (doVanilla) {
+      auto r = timeIt(vanillaPlan(input));
+      vanillaMs.push_back(r.first);
+      vanillaRows = r.second;
+      fprintf(stderr, "[q67] vanilla run %d: %lldms rows=%lld\n", i,
+              (long long)r.first, (long long)r.second);
+      fflush(stderr);
+    }
+    if (doFused) {
+      auto r = timeIt(fusedPlan(input));
+      fusedMs.push_back(r.first);
+      fusedRows = r.second;
+      fprintf(stderr, "[q67] fused   run %d: %lldms rows=%lld\n", i,
+              (long long)r.first, (long long)r.second);
+      fflush(stderr);
+    }
+  }
+
+  if (doVanilla && doFused) {
+    std::sort(vanillaMs.begin(), vanillaMs.end());
+    std::sort(fusedMs.begin(), fusedMs.end());
+    const auto vMed = vanillaMs[vanillaMs.size() / 2];
+    const auto fMed = fusedMs[fusedMs.size() / 2];
+    fprintf(
+        stderr,
+        "\n[q67] VANILLA (Expand+partial agg) best=%lldms median=%lldms rows=%lld\n"
+        "[q67] FUSED   (lattice+bypass)      best=%lldms median=%lldms rows=%lld\n"
+        "[q67] SPEEDUP best=%.2fx median=%.2fx\n\n",
+        (long long)vanillaMs.front(),
+        (long long)vMed,
+        (long long)vanillaRows,
+        (long long)fusedMs.front(),
+        (long long)fMed,
+        (long long)fusedRows,
+        (double)vanillaMs.front() / fusedMs.front(),
+        (double)vMed / fMed);
+    fflush(stderr);
+  }
+}
+
+/// Isolates the cost of the FINAL aggregation from the operator that produced
+/// its input.
+///
+/// Motivation: in the full-plan benchmark the final aggregation costs 414 ns
+/// per row on vanilla's output and ~718 ns per row on the fused operator's
+/// output, at IDENTICAL row counts. Flattening the fused output (GSAGG_FLATTEN)
+/// and equalising batch sizes (OUT_BATCH_ROWS) both change nothing, so it is
+/// neither encoding nor batching.
+///
+/// The remaining candidate is ROW ORDER. Vanilla's partial aggregation is keyed
+/// on exactly the final aggregation's key -- (k1..k8, gid) -- so it emits rows
+/// in hash-bucket order OF THE FINAL AGGREGATION'S OWN HASH FUNCTION.
+/// Consecutive rows then probe consecutive buckets: near-perfect locality. No
+/// producer other than an identically-keyed hash table can hand the final
+/// aggregation that gift, and in a real Gluten plan a network shuffle sits in
+/// between and destroys it.
+///
+/// This test captures each pre-shuffle output once, materialises it flat (so
+/// encoding is identical across arms), and then times ONLY the final
+/// aggregation over it -- as-is, and under a random permutation.
+TEST_F(Q67RollupBenchmarkTest, finalAggInIsolation) {
+  const char* dir = getenv("Q67_INPUT");
+  if (dir == nullptr) {
+    GTEST_SKIP() << "set Q67_INPUT to the exported q67 parquet directory";
+  }
+  auto input = loadInput(dir);
+
+  std::unordered_map<std::string, std::string> cfg{
+      {core::QueryConfig::kMaxPartialAggregationMemory, "2147483648"},
+      {core::QueryConfig::kMaxExtendedPartialAggregationMemory, "2147483648"}};
+
+  auto capture = [&](const core::PlanNodePtr& plan) {
+    return AssertQueryBuilder(plan).configs(cfg).copyResults(pool());
+  };
+
+  // Cuts `all` into flat batches, optionally permuted. copyResults already
+  // returned one contiguous flat vector, so both arms start from identical
+  // encoding and identical buffers; only the row ORDER differs.
+  auto toBatches = [&](const RowVectorPtr& all, bool permute) {
+    std::vector<RowVectorPtr> out;
+    const auto n = all->size();
+    std::vector<vector_size_t> perm(n);
+    std::iota(perm.begin(), perm.end(), 0);
+    if (permute) {
+      std::mt19937 rng(12345);
+      std::shuffle(perm.begin(), perm.end(), rng);
+    }
+    constexpr vector_size_t kBatch = 10'000;
+    for (vector_size_t off = 0; off < n; off += kBatch) {
+      const auto count = std::min<vector_size_t>(kBatch, n - off);
+      auto flat = std::static_pointer_cast<RowVector>(
+          BaseVector::create(all->type(), count, pool()));
+      for (vector_size_t i = 0; i < count; ++i) {
+        flat->copy(all.get(), i, perm[off + i], 1);
+      }
+      out.push_back(std::move(flat));
+    }
+    return out;
+  };
+
+  auto timeFinal = [&](const std::string& label,
+                       const std::vector<RowVectorPtr>& batches) {
+    auto g = keyNames();
+    g.push_back("gid");
+    auto plan = PlanBuilder(pool())
+                    .values(batches)
+                    .finalAggregation(g, {"sum(s) as s"}, {{DOUBLE()}})
+                    .planNode();
+    std::shared_ptr<Task> task;
+    int64_t best = std::numeric_limits<int64_t>::max();
+    int64_t rows = 0;
+    for (int i = 0; i < 3; ++i) {
+      const auto t0 = std::chrono::steady_clock::now();
+      rows = AssertQueryBuilder(plan).configs(cfg).countResults(task);
+      const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                          std::chrono::steady_clock::now() - t0)
+                          .count();
+      best = std::min(best, ms);
+    }
+    int64_t inRows = 0;
+    for (const auto& b : batches) {
+      inRows += b->size();
+    }
+    fprintf(
+        stderr,
+        "[finalAgg] %-34s in=%9lld out=%9lld best=%6lldms  %6.1f ns/row\n",
+        label.c_str(),
+        (long long)inRows,
+        (long long)rows,
+        (long long)best,
+        best * 1e6 / inRows);
+    fflush(stderr);
+  };
+
+  auto vOut = capture(vanillaPlan(input, false));
+  auto fOut = capture(fusedPlan(input, false));
+  fprintf(
+      stderr,
+      "\n[finalAgg] captured vanilla=%d rows, fused=%d rows\n",
+      vOut->size(),
+      fOut->size());
+
+  timeFinal("vanilla output, natural order", toBatches(vOut, false));
+  timeFinal("vanilla output, PERMUTED", toBatches(vOut, true));
+  timeFinal("fused output, natural order", toBatches(fOut, false));
+  timeFinal("fused output, PERMUTED", toBatches(fOut, true));
+}
