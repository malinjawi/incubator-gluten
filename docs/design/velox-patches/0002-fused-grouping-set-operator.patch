+/// Ground truth: the true distinct group count of every rollup level, and what
+/// a full (non-abandoning) aggregation of that level costs.
+TEST_F(Q67RollupBenchmarkTest, q67LevelCardinalities) {
+  const char* dir = getenv("Q67_INPUT");
+  if (dir == nullptr) {
+    GTEST_SKIP() << "set Q67_INPUT to the exported q67 parquet directory";
+  }
+  auto input = loadInput(dir);
+  const auto keys = keyNames();
+  int64_t total = 0;
+  for (auto dropped = 0; dropped <= kNumKeys; ++dropped) {
+    std::vector<std::string> g(keys.begin(), keys.end() - dropped);
+    auto plan = PlanBuilder(pool())
+                    .values(input)
+                    .singleAggregation(g, {"sum(v) as s"})
+                    .planNode();
+    std::shared_ptr<Task> task;
+    auto t0 = std::chrono::steady_clock::now();
+    const auto n = AssertQueryBuilder(plan).countResults(task);
+    const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+                        std::chrono::steady_clock::now() - t0)
+                        .count();
+    total += n;
+    double addIn = 0;
+    for (const auto& p : task->taskStats().pipelineStats) {
+      for (const auto& op : p.operatorStats) {
+        if (op.operatorType == "Aggregation") {
+          addIn = op.addInputTiming.wallNanos / 1e6;
+        }
+      }
+    }
+    fprintf(
+        stderr,
+        "[level] set%d keys=%zu distinct=%10lld  wall=%5lldms aggAddInput=%7.1fms\n",
+        dropped,
+        g.size(),
+        (long long)n,
+        (long long)ms,
+        addIn);
+    fflush(stderr);
+  }
+  fprintf(stderr, "[level] SUM over all 9 levels = %lld\n", (long long)total);
+}
