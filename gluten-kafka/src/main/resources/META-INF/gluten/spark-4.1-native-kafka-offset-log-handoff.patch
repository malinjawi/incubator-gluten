+package org.apache.spark.sql.execution.streaming.runtime
+
+import scala.collection.Map
+import scala.util.control.NonFatal
+
+import org.apache.spark.internal.Logging
+import org.apache.spark.sql.connector.read.streaming.{Offset, SparkDataStream}
+import org.apache.spark.util.Utils
+
+/**
+ * Optional runtime bridge used by Gluten's native Kafka source prototype.
+ *
+ * This lives in Spark runtime code but uses reflection so Spark itself does not need a compile-time
+ * dependency on Gluten. If Gluten Kafka is absent, the hook is a no-op. If Gluten Kafka is present
+ * but too old to expose the expected helper methods, fail closed rather than writing an offset log
+ * whose native handoff manifest cannot be prepared or validated.
+ */
+private[streaming] object GlutenKafkaOffsetLogHandoffHook extends Logging {
+  private val UtilClassName = "org.apache.spark.sql.kafka010.GlutenStreamKafkaSourceUtil$"
+
+  def prepareBeforeOffsetLogAdd(
+      sources: Seq[SparkDataStream],
+      startOffsets: Map[SparkDataStream, Offset],
+      endOffsets: Map[SparkDataStream, Offset]): Unit = {
+    invoke(
+      "prepareOffsetLogHandoffBeforeSparkOffsetLogAdd",
+      sources,
+      startOffsets,
+      endOffsets)
+  }
+
+  def validateAfterOffsetLogReplay(
+      sources: Seq[SparkDataStream],
+      startOffsets: Map[SparkDataStream, Offset],
+      endOffsets: Map[SparkDataStream, Offset]): Unit = {
+    invoke(
+      "validateOffsetLogHandoffAfterSparkOffsetLogReplay",
+      sources,
+      startOffsets,
+      endOffsets)
+  }
+
+  private def invoke(
+      methodName: String,
+      sources: Seq[SparkDataStream],
+      startOffsets: Map[SparkDataStream, Offset],
+      endOffsets: Map[SparkDataStream, Offset]): Unit = {
+    if (sources.isEmpty || endOffsets.isEmpty) {
+      return
+    }
+    try {
+      val module = Utils.classForName(UtilClassName).getField("MODULE$").get(null)
+      val method = module.getClass.getMethod(
+        methodName,
+        classOf[scala.collection.immutable.Seq[_]],
+        classOf[scala.collection.Map[_, _]],
+        classOf[scala.collection.Map[_, _]])
+      method.invoke(module, sources, startOffsets, endOffsets)
+    } catch {
+      case _: ClassNotFoundException =>
+        logDebug("Gluten Kafka is not on the classpath; skipping native offset-log handoff hook")
+      case e: NoSuchMethodException =>
+        throw new IllegalStateException(
+          s"Gluten Kafka offset-log handoff method $methodName is unavailable", e)
+      case e: java.lang.reflect.InvocationTargetException =>
+        throw e.getCause
+      case NonFatal(e) =>
+        throw e
+    }
+  }
+}
